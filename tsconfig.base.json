{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": false,
    "ignoreDeprecations": "6.0",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strictPropertyInitialization": false
  }
}
