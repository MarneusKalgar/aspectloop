{
  "name": "elemika",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.14.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "mocks/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @elemika/web",
    "dev:gateway": "npm run dev --workspace @elemika/gateway-api",
    "dev:extraction": "npm run dev --workspace @elemika/extraction-service",
    "dev:correction": "npm run dev --workspace @elemika/correction-service",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @elemika/web",
    "build:gateway": "npm run build --workspace @elemika/gateway-api",
    "build:extraction": "npm run build --workspace @elemika/extraction-service",
    "build:correction": "npm run build --workspace @elemika/correction-service",
    "build:contracts": "npm run build --workspace @elemika/contracts",
    "local:up": "bash infra/local/scripts/local-compose.sh up --build -d",
    "local:start": "bash infra/local/scripts/local-compose.sh up -d",
    "local:migrate": "bash infra/local/scripts/local-migrate.sh",
    "local:seed": "bash infra/local/scripts/local-seed.sh",
    "local:down": "bash infra/local/scripts/local-compose.sh down --remove-orphans",
    "local:reset": "bash infra/local/scripts/local-compose.sh down -v --remove-orphans",
    "local:db:generate:gateway": "bash infra/local/scripts/local-compose.sh exec -w /app/apps/gateway-api gateway-api npm run db:generate:local --",
    "format": "prettier --write \"{apps,mocks,packages,infra,docs}/**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\" \"*.{json,md,yml,yaml}\"",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx,js,mjs}\" --fix",
    "lint:ci": "eslint \"{apps,packages}/**/*.{ts,tsx,js,mjs}\"",
    "prepare": "husky",
    "type-check": "npm run type-check --workspace @elemika/web && tsc -p apps/gateway-api/tsconfig.json --noEmit && tsc -p apps/extraction-service/tsconfig.json --noEmit && tsc -p apps/correction-service/tsconfig.json --noEmit && tsc -p packages/contracts/tsconfig.json --noEmit"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^25.6.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  }
}
