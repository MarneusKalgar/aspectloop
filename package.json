{
  "name": "aspectloop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2 <13"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "mocks/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @aspectloop/web",
    "dev:gateway": "npm run dev --workspace @aspectloop/gateway-api",
    "dev:extraction": "npm run dev --workspace @aspectloop/extraction-service",
    "dev:correction": "npm run dev --workspace @aspectloop/correction-service",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace @aspectloop/web",
    "build:gateway": "npm run build --workspace @aspectloop/gateway-api",
    "build:extraction": "npm run build --workspace @aspectloop/extraction-service",
    "build:correction": "npm run build --workspace @aspectloop/correction-service",
    "build:contracts": "npm run build --workspace @aspectloop/contracts",
    "graphql:generate:gateway": "npm run graphql:generate --workspace @aspectloop/gateway-api",
    "graphql:generate:web": "GQL_CODEGEN_LOCAL_SCHEMA=true npm run graphql-codegen --workspace @aspectloop/web",
    "graphql:generate": "npm run graphql:generate:gateway && npm run graphql:generate:web",
    "graphql:check": "node scripts/graphql/check-generated.mjs",
    "deps:policy": "node scripts/check-dependency-policy.mjs",
    "deps:audit": "npm audit --audit-level=high",
    "deps:signatures": "npm audit signatures",
    "deps:scripts:pending": "npm install-scripts ls",
    "local:up": "bash infra/local/scripts/local-compose.sh up --build -d",
    "local:start": "bash infra/local/scripts/local-compose.sh up -d",
    "local:migrate": "bash infra/local/scripts/local-migrate.sh",
    "local:seed": "bash infra/local/scripts/local-seed.sh",
    "local:down": "bash infra/local/scripts/local-compose.sh down --remove-orphans",
    "local:reset": "bash infra/local/scripts/local-compose.sh down -v --remove-orphans",
    "local:db:generate:gateway": "bash infra/local/scripts/local-compose.sh exec -w /app/apps/gateway-api gateway-api npm run db:generate:local --",
    "format": "prettier --write \"{apps,mocks,packages,infra,docs,scripts/graphql}/**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"{apps,mocks,packages,infra,docs,scripts/graphql}/**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\" \"*.{json,md,yml,yaml}\"",
    "lint": "eslint \"{apps,packages,scripts/graphql}/**/*.{ts,tsx,js,mjs}\" --fix",
    "lint:ci": "eslint \"{apps,packages,scripts/graphql}/**/*.{ts,tsx,js,mjs}\"",
    "prepare": "husky",
    "test:unit:run": "npm run test:unit:run --workspace @aspectloop/web",
    "test:integration:run": "npm run test:integration:run --workspace @aspectloop/web",
    "test:e2e:mock": "npm run test:e2e:mock --workspace @aspectloop/web",
    "type-check": "npm run type-check --workspace @aspectloop/web && tsc -p apps/gateway-api/tsconfig.json --noEmit && tsc -p apps/extraction-service/tsconfig.json --noEmit && tsc -p apps/correction-service/tsconfig.json --noEmit && tsc -p packages/contracts/tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run lint:ci && npm run type-check && npm run graphql:check && npm run test:unit:run && npm run test:integration:run",
    "verify:full": "npm run verify && npm run build && npm run test:e2e:mock"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "allowScripts": {
    "msw": false,
    "@nestjs/core": false,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
