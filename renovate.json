{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "github-actions", "dockerfile", "docker-compose"],
  "timezone": "Europe/Kyiv",
  "schedule": ["before 9am on Monday"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "automerge": false,
  "ignoreDeps": ["immanuwell/dockerfile-roast"],
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Quarantine new npm releases",
      "matchManagers": ["npm"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Require dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require dashboard approval for platform and data dependencies",
      "matchPackageNames": [
        "/^@nestjs\\//",
        "/^@graphql-codegen\\//",
        "@graphql-yoga/nestjs",
        "graphql",
        "graphql-yoga",
        "typeorm",
        "pg",
        "amqplib",
        "passport",
        "passport-jwt",
        "bcryptjs",
        "jose",
        "@hookform/resolvers",
        "ajv-formats"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep the Playwright package and CI image under coordinated human review",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "dependencyDashboardApproval": true,
      "groupName": "playwright runtime pair"
    }
  ]
}
