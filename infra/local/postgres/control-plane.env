# Scoped local PostgreSQL control-plane contract. Compose interpolates values
# from infra/local/.env.local before injecting this file only into PostgreSQL,
# the disposable provisioner, and the disposable role verifier.
# PGHOST and PGPORT stay on the external tools because fresh PostgreSQL
# initialization connects to its temporary server over a Unix socket.
POSTGRES_USER=${POSTGRES_ADMIN_USER:-aspectloop_admin}
POSTGRES_PASSWORD=${POSTGRES_ADMIN_PASSWORD:-aspectloop_admin}
POSTGRES_DB=${POSTGRES_ADMIN_DATABASE:-postgres}
POSTGRES_ADMIN_USER=${POSTGRES_ADMIN_USER:-aspectloop_admin}
POSTGRES_ADMIN_PASSWORD=${POSTGRES_ADMIN_PASSWORD:-aspectloop_admin}
POSTGRES_ADMIN_DATABASE=${POSTGRES_ADMIN_DATABASE:-postgres}
POSTGRES_MAX_CONNECTIONS=${POSTGRES_MAX_CONNECTIONS:-100}
POSTGRES_SUPERUSER_RESERVED_CONNECTIONS=${POSTGRES_SUPERUSER_RESERVED_CONNECTIONS:-3}
POSTGRES_OPERATIONAL_HEADROOM=${POSTGRES_OPERATIONAL_HEADROOM:-20}
POSTGRES_TOOL_CONNECTION_BUDGET=${POSTGRES_TOOL_CONNECTION_BUDGET:-6}
GATEWAY_DB_POOL_SIZE=${GATEWAY_DB_POOL_SIZE:-5}
PLATFORM_DB_POOL_SIZE=${PLATFORM_DB_POOL_SIZE:-5}
EXTRACTION_DB_POOL_SIZE=${EXTRACTION_DB_POOL_SIZE:-10}
CORRECTION_DB_POOL_SIZE=${CORRECTION_DB_POOL_SIZE:-10}
PLATFORM_DATABASE_NAME=${PLATFORM_DATABASE_NAME:-platform_db}
PLATFORM_MIGRATOR_USER=${PLATFORM_MIGRATOR_USER:-platform_migrator}
PLATFORM_MIGRATOR_PASSWORD=${PLATFORM_MIGRATOR_PASSWORD:-platform_migrator}
PLATFORM_RUNTIME_USER=${PLATFORM_RUNTIME_USER:-platform_runtime}
PLATFORM_RUNTIME_PASSWORD=${PLATFORM_RUNTIME_PASSWORD:-platform_runtime}
GATEWAY_CORRECTION_RUNTIME_USER=${GATEWAY_CORRECTION_RUNTIME_USER:-gateway_correction_runtime}
GATEWAY_CORRECTION_RUNTIME_PASSWORD=${GATEWAY_CORRECTION_RUNTIME_PASSWORD:-gateway_correction_runtime}
EXTRACTION_DATABASE_NAME=${EXTRACTION_DATABASE_NAME:-extraction_db}
EXTRACTION_DATABASE_USER=${EXTRACTION_DATABASE_USER:-extraction_app}
EXTRACTION_DATABASE_PASSWORD=${EXTRACTION_DATABASE_PASSWORD:-extraction_app}
CORRECTION_DATABASE_NAME=${CORRECTION_DATABASE_NAME:-correction_db}
CORRECTION_DATABASE_USER=${CORRECTION_DATABASE_USER:-correction_app}
CORRECTION_DATABASE_PASSWORD=${CORRECTION_DATABASE_PASSWORD:-correction_app}
