# AspectLoop local infrastructure environment template
# Copy to .env.local for the local Compose stack and adjust values if needed.

# PostgreSQL host and bootstrap administrator. The administrator is local-only
# and must not be used by application services.
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=aspectloop_admin
POSTGRES_ADMIN_PASSWORD=aspectloop_admin
POSTGRES_ADMIN_DATABASE=postgres

# One database and least-privilege role per backend service.
PLATFORM_DATABASE_NAME=platform_db
PLATFORM_DATABASE_USER=platform_app
PLATFORM_DATABASE_PASSWORD=platform_app
EXTRACTION_DATABASE_NAME=extraction_db
EXTRACTION_DATABASE_USER=extraction_app
EXTRACTION_DATABASE_PASSWORD=extraction_app
CORRECTION_DATABASE_NAME=correction_db
CORRECTION_DATABASE_USER=correction_app
CORRECTION_DATABASE_PASSWORD=correction_app

# Local connection budget: 100 total, 3 superuser-reserved, 30 for one replica
# of each service, 6 for bounded tools, and at least 20 operational headroom.
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_SUPERUSER_RESERVED_CONNECTIONS=3
POSTGRES_OPERATIONAL_HEADROOM=20
POSTGRES_TOOL_CONNECTION_BUDGET=6
PLATFORM_DB_POOL_SIZE=10
EXTRACTION_DB_POOL_SIZE=10
CORRECTION_DB_POOL_SIZE=10
