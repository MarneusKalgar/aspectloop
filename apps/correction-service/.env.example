# AspectLoop correction service local environment template

NODE_ENV=development
CORRECTION_SERVICE_PORT=8082
APP_LOG_LEVEL=info

# Correction-owned database. Keep credentials aligned with the correction role
# in infra/local/.env.local.
DATABASE_URL=postgresql://correction_app:correction_app@postgres:5432/correction_db
DB_POOL_SIZE=10
DB_SLOW_QUERY_THRESHOLD_MS=1000
