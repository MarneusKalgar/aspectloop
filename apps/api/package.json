{
  "name": "@elemika/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typeorm": "NODE_ENV=development TS_NODE_PROJECT=tsconfig.app.json ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js",
    "db:generate:local": "npm run typeorm -- migration:generate -d ./src/data-source.ts",
    "db:migrate:local": "npm run typeorm -- migration:run -d ./src/data-source.ts",
    "db:revert:local": "npm run typeorm -- migration:revert -d ./src/data-source.ts",
    "db:seed:local": "NODE_ENV=development ts-node -r tsconfig-paths/register ./src/db/seed/index.ts",
    "docker:build:local": "bash scripts/docker/local-compose.sh up --build",
    "docker:start:local": "bash scripts/docker/local-compose.sh up",
    "docker:db:generate:local": "bash scripts/docker/local-compose.sh exec -w /app/apps/api api npm run db:generate:local --",
    "docker:migrate:local": "bash scripts/docker/local-migrate.sh",
    "docker:seed:local": "bash scripts/docker/local-seed.sh",
    "docker:down:local": "bash scripts/docker/local-compose.sh down -v --remove-orphans"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "nestjs-pino": "^4.6.1",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.29"
  }
}
