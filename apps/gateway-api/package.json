{
  "name": "@aspectloop/gateway-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "graphql:generate": "node scripts/generate-graphql-definitions.mjs",
    "typeorm": "NODE_ENV=development TS_NODE_PROJECT=tsconfig.app.json ts-node -r tsconfig-paths/register ../../node_modules/typeorm/cli.js",
    "db:generate:local": "npm run typeorm -- migration:generate -d ./src/data-source.ts",
    "db:migrate:local": "npm run typeorm -- migration:run -d ./src/data-source.ts",
    "db:revert:local": "npm run typeorm -- migration:revert -d ./src/data-source.ts",
    "db:seed:local": "NODE_ENV=development ts-node -r tsconfig-paths/register ./src/db/seed/index.ts"
  },
  "dependencies": {
    "@aspectloop/backend-platform": "^0.1.0",
    "@graphql-yoga/nestjs": "^3.22.2",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/typeorm": "^11.0.1",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "graphql": "^16.14.0",
    "graphql-yoga": "^5.21.2",
    "ms": "^2.1.3",
    "nestjs-pino": "^4.6.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-morph": "^28.0.0",
    "typeorm": "^0.3.29"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/passport-jwt": "^4.0.1"
  }
}
