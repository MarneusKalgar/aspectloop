{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": ["document-registry/configs/*.json", "graphql/schema/*.graphql"],
    "deleteOutDir": true,
    "watchAssets": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.app.json"
  }
}
