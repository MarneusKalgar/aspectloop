# AspectLoop API local environment template
# Copy to .env.local and adjust values if needed.

NODE_ENV=development
API_PORT=8080
APP_LOG_LEVEL=info
BCRYPT_SALT_ROUNDS=10

# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Gateway database. Local infrastructure creates this database and role from
# infra/local/.env.local; this application connects only to platform_db.
DATABASE_PROVIDER=postgres
DATABASE_HOST=postgres
DATABASE_URL=postgresql://platform_app:platform_app@postgres:5432/platform_db
DB_POOL_SIZE=5
DB_SLOW_QUERY_THRESHOLD_MS=1000
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_TTL=15m

# Private Platform service boundary. Docker Compose overrides the host URL with
# the internal service name.
PLATFORM_BASE_URL=http://127.0.0.1:8083
PLATFORM_REQUEST_TIMEOUT_MS=5000

# Private platform source-object storage. Host-run services use the loopback
# endpoint; Docker Compose overrides it with the internal Garage service name.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_REQUEST_TIMEOUT_MS=5000
PLATFORM_S3_BUCKET=aspectloop-platform-source
PLATFORM_S3_ACCESS_KEY_ID=generate-with-local-garage-init
PLATFORM_S3_SECRET_ACCESS_KEY=generate-with-local-garage-init

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=aspectloop
RABBITMQ_PASSWORD=aspectloop
CORRECTION_OUTBOX_FLUSH_INTERVAL_MS=5000

# Persistence mock
PERSISTENCE_BASE_URL=http://persistence-mock:8090
PERSISTENCE_MOCK_PORT=8090
# Used by the persistence-mock container in Docker Compose.
PERSISTENCE_MOCK_DATA_DIR=/data/documents
PERSISTENCE_REQUEST_TIMEOUT_MS=5000
