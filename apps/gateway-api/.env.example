# Elemika API local environment template
# Copy to .env.local for the dev compose stack and adjust values if needed.

NODE_ENV=development
API_PORT=8080
APP_LOG_LEVEL=info
BCRYPT_SALT_ROUNDS=10

# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database
DATABASE_PROVIDER=postgres
DATABASE_HOST=postgres
POSTGRES_USER=elemika
POSTGRES_PASSWORD=elemika
POSTGRES_DB=elemika
DATABASE_URL=postgresql://elemika:elemika@postgres:5432/elemika
DB_POOL_SIZE=10
DB_SLOW_QUERY_THRESHOLD_MS=1000
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_TTL=15m

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=elemika
RABBITMQ_PASSWORD=elemika
CORRECTION_OUTBOX_FLUSH_INTERVAL_MS=5000

# Persistence mock
PERSISTENCE_BASE_URL=http://persistence-mock:8090
PERSISTENCE_MOCK_PORT=8090
# Used by the persistence-mock container in Docker Compose.
PERSISTENCE_MOCK_DATA_DIR=/data/documents
PERSISTENCE_REQUEST_TIMEOUT_MS=5000
