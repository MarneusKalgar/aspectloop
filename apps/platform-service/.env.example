# AspectLoop Platform service local environment template

NODE_ENV=development
PLATFORM_SERVICE_PORT=8083
APP_LOG_LEVEL=info

# Platform-owned database. M04.1-B temporarily shares the existing local role
# with gateway; M04.1-C introduces separate migrator and runtime identities.
DATABASE_URL=postgresql://platform_app:platform_app@postgres:5432/platform_db
DB_POOL_SIZE=5
DB_SLOW_QUERY_THRESHOLD_MS=1000

# Platform issues access tokens; gateway retains the matching verification
# secret while M04.1 preserves the current stateless authentication behavior.
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_TTL=15m
BCRYPT_SALT_ROUNDS=10

# Platform-owned source-object storage. The local credential initializer
# replaces placeholders and derives the fixed local Garage topology values.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_REQUEST_TIMEOUT_MS=5000
PLATFORM_S3_BUCKET=aspectloop-platform-source
PLATFORM_S3_ACCESS_KEY_ID=generate-with-local-garage-init
PLATFORM_S3_SECRET_ACCESS_KEY=generate-with-local-garage-init
