# AspectLoop Platform service local environment template

NODE_ENV=development
PLATFORM_SERVICE_PORT=8083
APP_LOG_LEVEL=info

# Platform runtime database identity. Schema ownership and migrations use a
# separate tool-only identity supplied by local infrastructure.
DATABASE_URL=postgresql://platform_runtime:platform_runtime@postgres:5432/platform_db
DB_POOL_SIZE=5
DB_SLOW_QUERY_THRESHOLD_MS=1000

# Platform-owned access-token and persisted-session policy. Gateway retains the
# matching access-token verification contract but never receives the HMAC key.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL=15m
JWT_ACCESS_ISSUER=aspectloop-platform
JWT_ACCESS_AUDIENCE=aspectloop-gateway
AUTH_TOKEN_HMAC_SECRET=replace-with-at-least-32-characters
AUTH_SESSION_ABSOLUTE_TTL_MS=604800000
AUTH_SESSION_IDLE_TTL_MS=86400000
AUTH_REFRESH_GRACE_MS=5000
AUTH_EMAIL_CONFIRMATION_TTL_MS=86400000
AUTH_EMAIL_CONFIRMATION_RESEND_COOLDOWN_MS=60000
BCRYPT_SALT_ROUNDS=10

# Platform-owned source-object storage. The local credential initializer
# replaces placeholders and derives the fixed local Garage topology values.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_FORCE_PATH_STYLE=true
S3_REQUEST_TIMEOUT_MS=5000
PLATFORM_S3_BUCKET=aspectloop-platform-source
PLATFORM_S3_ACCESS_KEY_ID=generate-with-local-garage-init
PLATFORM_S3_SECRET_ACCESS_KEY=generate-with-local-garage-init
