# Elemika web local environment template
# Copy to .env.local for frontend development.

WEB_PORT=5173
VITE_API_URL=http://localhost:8080
VITE_APP_NAME=Elemika Correction
VITE_MOCK_GQL_RUNTIME=false

# Frontend-owned GraphQL schema source for code generation.
# Keep these values out of browser-exposed VITE_* variables.
GQL_SCHEMA_URL=
GQL_SCHEMA_AUTH_HEADER=
