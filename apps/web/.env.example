# AspectLoop web local environment template
# Copy to .env.local for frontend development.
# Do not set NODE_ENV here; Vite derives it from the invoked command.

WEB_PORT=5173
VITE_API_URL=http://localhost:8080
VITE_APP_NAME=AspectLoop
VITE_MOCK_GQL_RUNTIME=false

# Optional live GraphQL schema source for code generation.
# When omitted, codegen reads the gateway-owned SDL directly.
GQL_SCHEMA_URL=
