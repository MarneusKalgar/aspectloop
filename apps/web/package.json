{
  "name": "@aspectloop/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "npm run type-check && vite build",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "graphql-codegen": "graphql-codegen --config codegen.ts",
    "graphql-codegen:watch": "graphql-codegen --config codegen.ts --watch",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "npm run test:unit",
    "test:unit": "vitest --config vitest.unit.config.ts",
    "test:run": "npm run test:unit:run",
    "test:unit:run": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest --config vitest.integration.config.ts",
    "test:integration:run": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@apollo/client": "^4.1.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/material": "^9.0.1",
    "graphql": "^16.14.0",
    "i18next": "^26.1.0",
    "jose": "^6.2.3",
    "react": "^19.2.6",
    "react-cookie": "^8.1.2",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.15.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/client-preset": "^6.0.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv-formats": "^2.1.1",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "storybook": "^10.4.0",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
