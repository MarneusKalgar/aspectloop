# AspectLoop extraction service local environment template

NODE_ENV=development
EXTRACTION_SERVICE_PORT=8081
APP_LOG_LEVEL=info

# Extraction-owned database. Keep credentials aligned with the extraction role
# in infra/local/.env.local.
DATABASE_URL=postgresql://extraction_app:extraction_app@postgres:5432/extraction_db
DB_POOL_SIZE=10
DB_SLOW_QUERY_THRESHOLD_MS=1000
